# Copy this file to ".env" and fill in your Runway key to enable real video generation.
# Without a key the demo still runs — "build your own" falls back to a sample clip.

# Your Runway API key (from https://dev.runwayml.com → API Keys)
RUNWAY_API_KEY=

# Optional overrides (defaults are fine for most accounts)
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1
RUNWAY_MODEL=gen4_turbo
# Runway API version header (date-stamped); update if Runway bumps it
RUNWAY_VERSION=2024-11-06

# Port for the local server
PORT=3000
