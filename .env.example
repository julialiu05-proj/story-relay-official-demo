# Copy this file to ".env" and fill in your Runway key to enable real video generation.
# Without a key the demo still runs — "build your own" falls back to a sample clip.

# Your Runway API key (from https://dev.runwayml.com → API Keys)
RUNWAY_API_KEY=

# Optional overrides (defaults are fine for most accounts)
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1
RUNWAY_MODEL=gen4_turbo
# Runway API version header (date-stamped); update if Runway bumps it
RUNWAY_VERSION=2024-11-06

# Your Anthropic (Claude) API key — powers optional dynamic story starters /
# better video prompts (from https://console.anthropic.com → API Keys).
# Optional: leave blank to keep everything scripted. Server-side only, like above.
ANTHROPIC_API_KEY=

# Port for the local server
PORT=3000

# --- guardrails for the public /api/generate proxy (optional; sensible defaults) ---
# RATE_MAX=5              # max generate calls per IP per window
# RATE_WINDOW_MS=60000    # rate-limit window (ms)
# DAILY_CAP=50            # max real generations per day (caps spend)
# ALLOWED_ORIGINS=        # comma-separated extra origins allowed to call the proxy
